# ===========================================
# wright-telemetry — local dev environment
# ===========================================
# Copy to .env in the repo root. scripts/dev.sh sources it for you:
#   ./scripts/dev.sh
#
# You only need this file to point the agent at a NON-default backend — most
# often a git worktree's stack. For a plain main checkout, scripts/dev.sh
# already defaults to localhost with the right ports.
#
# ---------------------------------------------------------------------------
# IMPORTANT: these are read from the ENVIRONMENT only (wright_telemetry/
# settings.py), and their built-in defaults are the PRODUCTION
# api.wrightfan.com URLs. Launching `python main.py --gui` by hand therefore
# talks to production unless you export them — or, worse, to whatever another
# checkout's shell exported, which shows up as "Connection refused" against a
# port nothing is serving. Prefer ./scripts/dev.sh, which sets them for you.
# ---------------------------------------------------------------------------

# -----------------------------------------
# Backend endpoints
# -----------------------------------------
# Portal / provisioning API — access-key redeem, agent-info, agent-config.
# The portal's Fastify BFF (apps/api), NOT the Next.js web app.
export WRIGHT_API_URL=http://localhost:3001

# Pipeline ingest-gateway — POST /api/v2/telemetry
export WRIGHT_INGEST_URL=http://localhost:8080

# Pipeline ws-gateway — agent websocket
export WRIGHT_WS_URL=http://localhost:8082

# -----------------------------------------
# Git worktrees
# -----------------------------------------
# Every port is its default plus that worktree's PORT_OFFSET, so offset 100 is:
#
#   export WRIGHT_API_URL=http://localhost:3101
#   export WRIGHT_INGEST_URL=http://localhost:8180
#   export WRIGHT_WS_URL=http://localhost:8182
#
# new-feature.sh writes exactly that into each worktree's .env. Alternatively
# set PORT_OFFSET and let scripts/dev.sh derive all three:
#export PORT_OFFSET=100
#
# See docs/WORKTREE_DEV.md.

# -----------------------------------------
# Credentials (NOT set here)
# -----------------------------------------
# The API key and facility ID come from redeeming an access key against the
# portal, and are written to ~/.wright-telemetry/config.json. Entry is
# interactive only — the TUI prompt or the GUI's Access Key page. There is no
# CLI flag or env var for it.
